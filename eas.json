{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EAS_BUILD_DISABLE_EXPO_DOCTOR": "true"
      }
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EAS_BUILD_DISABLE_EXPO_DOCTOR": "true"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EAS_BUILD_DISABLE_EXPO_DOCTOR": "true"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
